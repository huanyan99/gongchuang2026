<page-meta page-style="overflow: hidden;" />
<scroll-view
  class="page-scroll"
  scroll-y
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
  bounces="{{true}}"
  scroll-with-animation="{{true}}"
>
<view class="page">
  <view class="head">
    <image class="head-bg" src="/images/banner.jpg" mode="aspectFill" />
    <view class="head-shade"></view>
    <view class="head-copy">
      <view class="eyebrow">SEATING MAP</view>
      <view class="title">桌位图</view>
      <view class="gold-line"></view>
      <view class="sub">{{eventCity}}场</view>
    </view>
  </view>

  <view wx:if="{{eventCity === '上海'}}" class="state-card">暂未更新~</view>
  <view wx:elif="{{loading}}" class="state-card">正在加载 ···</view>

  <block wx:elif="{{eventCity !== '上海'}}">
    <block wx:if="{{mySeats.length}}">
      <view wx:for="{{mySeats}}" wx:key="index" class="seat-card">
        <text class="seat-name">{{item.name}}</text>
        <view class="seat-no-row">
          <text class="seat-no">{{item.tableNo}}</text>
          <text class="seat-unit">桌</text>
        </view>
      </view>
    </block>
    <view wx:elif="{{published}}" class="state-card">未查询到您的桌号，请联系现场会务人员</view>
    <view wx:else class="state-card">桌位安排尚未发布</view>

    <image wx:if="{{hallImage}}" class="hall-image" src="{{hallImage}}" mode="widthFix" bindtap="previewHall" />
    <view wx:else class="hall-placeholder">全场位置图待发布</view>
  </block>
</view>
</scroll-view>
