page {
  background: #f4f6fb;
}

.page {
  min-height: 100vh;
  color: #111827;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-bottom-left-radius: 46rpx;
  border-bottom-right-radius: 46rpx;
  background: #0b1b47;
}

.head-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.head-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(6, 16, 45, 0.1), rgba(6, 16, 45, 0.78));
}

.head-copy {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 42rpx;
  color: #ffffff;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 800;
}

.gold-line {
  margin-top: 18rpx;
  width: 82rpx;
  height: 3rpx;
  background: #d6b56d;
}

.sub {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
}

.state-card {
  margin: -28rpx 28rpx 0;
  padding: 54rpx 40rpx;
  color: #6f7788;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid rgba(214, 181, 109, 0.22);
  border-radius: 24rpx;
  box-shadow: 0 26rpx 56rpx rgba(13, 31, 76, 0.1);
}

.seat-card {
  position: relative;
  margin: -28rpx 28rpx 0;
  padding: 40rpx 36rpx 36rpx;
  overflow: hidden;
  color: #10244f;
  background: linear-gradient(135deg, #f7e8bc 0%, #d9b86f 48%, #f3dda5 100%);
  border: 1rpx solid rgba(168, 125, 49, 0.72);
  border-radius: 24rpx;
  box-shadow: 0 22rpx 48rpx rgba(143, 104, 39, 0.2), inset 0 0 0 1rpx rgba(255, 255, 255, 0.48);
}

.seat-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 190rpx;
  height: 190rpx;
  border: 1rpx solid rgba(93, 64, 20, 0.16);
  border-radius: 50%;
  box-shadow: 0 0 0 20rpx rgba(255, 250, 231, 0.16);
}

.seat-eyebrow {
  color: rgba(52, 42, 25, 0.62);
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  font-weight: 700;
}

.seat-no-row {
  position: relative;
  margin-top: 22rpx;
  display: flex;
  align-items: baseline;
}

.seat-no {
  color: #10244f;
  font-size: 96rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.seat-unit {
  margin-left: 12rpx;
  color: #10244f;
  font-size: 30rpx;
  font-weight: 700;
}

.seat-name {
  position: relative;
  margin-top: 20rpx;
  color: #17284f;
  font-size: 30rpx;
  font-weight: 700;
}

.seat-meta {
  position: relative;
  margin-top: 12rpx;
  color: rgba(52, 42, 25, 0.7);
  font-size: 22rpx;
}

.seat-party {
  position: relative;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(93, 64, 20, 0.2);
}

.party-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #24345c;
  font-size: 24rpx;
}

.hall {
  margin: 28rpx;
  padding: 30rpx 28rpx 34rpx;
  background: linear-gradient(160deg, #102557, #26397b 54%, #0d214f);
  border: 1rpx solid rgba(210, 176, 105, 0.3);
  border-radius: 24rpx;
  box-shadow: 0 22rpx 50rpx rgba(15, 31, 69, 0.24);
}

.hall-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  color: #ffffff;
}

.hall-head text:first-child {
  font-size: 28rpx;
  font-weight: 700;
}

.hall-head text:last-child {
  color: rgba(255, 255, 255, 0.6);
  font-size: 21rpx;
}

.hall-stage {
  margin-top: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #f4e3b8;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  background: linear-gradient(180deg, rgba(212, 176, 105, 0.3), rgba(212, 176, 105, 0.08));
  border: 1rpx solid rgba(226, 194, 124, 0.5);
  border-radius: 12rpx 12rpx 40rpx 40rpx;
}

.tables {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}

.table {
  width: 25%;
  padding: 12rpx 0;
  display: flex;
  justify-content: center;
}

.table-round {
  width: 130rpx;
  height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  box-sizing: border-box;
}

.table.mine .table-round {
  color: #10244f;
  background: linear-gradient(135deg, #f7e8bc, #d9b86f);
  border-color: rgba(255, 250, 231, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(8, 18, 48, 0.32), 0 0 0 6rpx rgba(226, 194, 124, 0.18);
}

.table-no {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
}

.table-count {
  margin-top: 10rpx;
  font-size: 19rpx;
  line-height: 1;
  opacity: 0.72;
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 22rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 10rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 50%;
}

.dot.mine {
  background: linear-gradient(135deg, #f7e8bc, #d9b86f);
  border-color: rgba(255, 250, 231, 0.9);
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(5, 12, 32, 0.58);
  animation: maskFade 260ms ease both;
}

.detail-card {
  width: 100%;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  animation: sheetUp 300ms cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.detail-head {
  display: flex;
  align-items: center;
}

.detail-no {
  color: #132653;
  font-size: 40rpx;
  font-weight: 800;
}

.detail-tag {
  margin-left: 18rpx;
  padding: 7rpx 16rpx;
  color: #8a6a20;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  background: rgba(214, 181, 109, 0.18);
  border: 1rpx solid rgba(168, 125, 49, 0.5);
  border-radius: 20rpx;
}

.detail-line {
  margin-top: 16rpx;
  color: #6f7788;
  font-size: 24rpx;
}

.detail-guests {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f6;
}

.detail-guest {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #24345c;
  font-size: 25rpx;
}

.detail-note {
  margin-top: 24rpx;
  padding-top: 18rpx;
  color: #9aa0a8;
  font-size: 21rpx;
  line-height: 1.6;
  border-top: 1rpx solid #edf0f6;
}

.detail-close {
  margin-top: 32rpx;
  height: 86rpx;
  line-height: 86rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  background: #26397b;
  border-radius: 44rpx;
}

@keyframes maskFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
