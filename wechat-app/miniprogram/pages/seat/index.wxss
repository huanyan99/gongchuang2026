page {
  background: #f4f6fb;
}

.page {
  min-height: 100vh;
  color: #111827;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-bottom-left-radius: 46rpx;
  border-bottom-right-radius: 46rpx;
  background: #0b1b47;
}

.head-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.head-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(6, 16, 45, 0.1), rgba(6, 16, 45, 0.78));
}

.head-copy {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 42rpx;
  color: #ffffff;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 800;
}

.gold-line {
  margin-top: 18rpx;
  width: 82rpx;
  height: 3rpx;
  background: #d6b56d;
}

.sub {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
}

.state-card {
  margin: -28rpx 28rpx 0;
  padding: 54rpx 40rpx;
  color: #6f7788;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid rgba(214, 181, 109, 0.22);
  border-radius: 24rpx;
  box-shadow: 0 26rpx 56rpx rgba(13, 31, 76, 0.1);
}

.seat-card {
  position: relative;
  margin: -28rpx 28rpx 0;
  padding: 48rpx 36rpx 44rpx;
  overflow: hidden;
  text-align: center;
  color: #10244f;
  background: linear-gradient(135deg, #f7e8bc 0%, #d9b86f 48%, #f3dda5 100%);
  border: 1rpx solid rgba(168, 125, 49, 0.72);
  border-radius: 24rpx;
  box-shadow: 0 22rpx 48rpx rgba(143, 104, 39, 0.2), inset 0 0 0 1rpx rgba(255, 255, 255, 0.48);
}

.seat-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 190rpx;
  height: 190rpx;
  border: 1rpx solid rgba(93, 64, 20, 0.16);
  border-radius: 50%;
  box-shadow: 0 0 0 20rpx rgba(255, 250, 231, 0.16);
}

.seat-eyebrow {
  position: relative;
  color: rgba(52, 42, 25, 0.62);
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  font-weight: 700;
}

.seat-no-row {
  position: relative;
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.seat-no {
  color: #10244f;
  font-size: 150rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.seat-unit {
  margin-left: 14rpx;
  color: #10244f;
  font-size: 40rpx;
  font-weight: 700;
}

.seat-name {
  position: relative;
  margin-top: 24rpx;
  color: #17284f;
  font-size: 30rpx;
  font-weight: 700;
}

.seat-party {
  position: relative;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(93, 64, 20, 0.2);
}

.party-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #24345c;
  font-size: 24rpx;
}

.hall-image {
  display: block;
  width: calc(100% - 56rpx);
  margin: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(13, 31, 76, 0.1);
}

.hall-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 420rpx;
  margin: 28rpx;
  color: #a8afbd;
  font-size: 24rpx;
  background: #ffffff;
  border: 2rpx dashed #d4d9e4;
  border-radius: 20rpx;
}
