page { background:#f4f6fb; color:#12224a; }
.page { min-height:100vh; padding-bottom:60rpx; }
.hero { padding:46rpx 30rpx 42rpx; color:#fff; background:linear-gradient(145deg,#081a40,#294681); }
.eyebrow { display:block; color:#d6b871; font-size:18rpx; letter-spacing:4rpx; }
.title { display:block; margin-top:14rpx; font-size:42rpx; font-weight:800; }
.sub { display:block; margin-top:14rpx; color:rgba(255,255,255,.66); font-size:22rpx; }
.status-tabs { display:flex; margin:-20rpx 24rpx 28rpx; padding:12rpx; position:relative; background:#fff; border-radius:16rpx; box-shadow:0 14rpx 32rpx rgba(16,34,74,.1); }
.status-tabs view { flex:1; padding:20rpx 0; text-align:center; border-radius:10rpx; }
.status-tabs view.active { color:#fff; background:#203b78; }
.status-tabs text { display:block; font-size:22rpx; }
.status-tabs text:first-child { margin-bottom:8rpx; font-size:34rpx; font-weight:800; color:#a67c35; }
.status-tabs view.active text:first-child { color:#efd18a; }
.record-card { margin:20rpx 24rpx; padding:30rpx; background:#fff; border:1rpx solid rgba(190,158,91,.25); border-radius:16rpx; box-shadow:0 10rpx 28rpx rgba(16,32,68,.05); }
.record-head { display:flex; justify-content:space-between; font-size:30rpx; font-weight:800; }
.record-head text:last-child { color:#a67c35; font-size:23rpx; }
.record-meta { display:block; margin-top:14rpx; color:#7b8290; font-size:23rpx; }
.record-summary { display:grid; grid-template-columns:130rpx 1fr 130rpx 1fr; gap:10rpx; margin-top:20rpx; padding:18rpx; color:#7b8290; font-size:22rpx; background:#f7f9fd; border-radius:10rpx; }
.record-summary text:nth-child(2),.record-summary text:nth-child(4) { color:#20386f; font-weight:700; }
.guest-list { margin-top:22rpx; padding-top:8rpx; border-top:1rpx solid #edf0f5; }
.guest-row { margin-top:18rpx; padding:22rpx; background:#fafbfe; border:1rpx solid #e4e8ef; border-radius:12rpx; }
.guest-title { padding-bottom:13rpx; color:#172d60; font-size:26rpx; font-weight:800; border-bottom:1rpx solid #e4e8ef; }
.detail-row { display:flex; justify-content:space-between; gap:20rpx; margin-top:13rpx; font-size:23rpx; line-height:1.5; }
.detail-row text:first-child { color:#8a7447; }
.detail-row text:last-child { flex:1; color:#263149; text-align:right; word-break:break-all; }
.review-actions { display:flex; gap:14rpx; margin-top:24rpx; }
.review-actions button { flex:1; margin:0; font-size:24rpx; color:#263f7f; background:#f2f5fb; }
.review-actions button::after { border:0; }
.review-actions .approve { color:#fff; background:#263f7f; }
.empty { margin:30rpx 24rpx; padding:70rpx 20rpx; text-align:center; color:#969ca8; background:#fff; border-radius:16rpx; }
