page{background:#071738}.page{min-height:100vh;padding:56rpx 30rpx;box-sizing:border-box;background:linear-gradient(180deg,#071738,#17356d)}.letter-card{padding:58rpx 42rpx;color:#17284f;background:linear-gradient(145deg,#fffdf7,#f7edda);border:2rpx solid #d5b66f;border-radius:18rpx;box-shadow:0 28rpx 70rpx rgba(0,0,0,.25)}.eyebrow{text-align:center;color:#98752e;font-size:18rpx;letter-spacing:5rpx}.title{margin-top:24rpx;text-align:center;font-size:48rpx;font-weight:800}.gem{margin:24rpx auto 42rpx;width:12rpx;height:12rpx;background:#bd9548;transform:rotate(45deg)}.body{margin-top:24rpx;font-size:27rpx;line-height:1.9}.event{display:flex;justify-content:space-between;margin-top:48rpx;padding:28rpx;color:#fff;background:#17356d;border-radius:10rpx;font-size:28rpx;font-weight:700}.note{margin-top:28rpx;color:#8c8373;font-size:21rpx;line-height:1.6;text-align:center}
