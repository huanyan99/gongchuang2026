<page-meta page-style="overflow: hidden;" />
<scroll-view
  class="page-scroll"
  scroll-y
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
  bounces="{{true}}"
  scroll-with-animation="{{true}}"
>
<view class="login-page">
  <view class="login-hero">
    <view class="eyebrow">BOCHU INVITATION</view>
    <view class="title">{{profileReady ? '个人中心' : '贵宾登录'}}</view>
    <view wx:if="{{!profileReady}}" class="sub">柏楚2026价值共创峰会</view>
  </view>

  <view class="member-card {{profileReady ? 'compact' : ''}}">
    <view class="card-shine"></view>
    <view wx:if="{{profileReady}}" class="profile-badge">贵宾档案</view>
    <view class="card-label">BOCHU</view>
    <view class="card-title">{{profileReady ? name : 'VALUE CO-CREATION'}}</view>
    <view class="card-sub">{{profileReady ? genderText : '2026 VIP ACCESS'}}</view>
    <view class="card-lines">
      <view></view>
      <view></view>
      <view></view>
    </view>
  </view>

  <view class="login-panel">
    <block wx:if="{{!wxLogged}}">
      <button class="login-btn primary" open-type="getPhoneNumber" bindgetphonenumber="handleLogin" loading="{{logging}}" disabled="{{logging}}">微信登录</button>
      <view class="hint">点击登录后，微信将询问是否允许提供手机号，用于会务联络及登记预填。仅在您同意后获取；拒绝仍可登录并手动填写。</view>
    </block>

    <block wx:elif="{{!profileReady && hintKnown}}">
      <view class="panel-card verify-card">
        <view class="label">姓名核验</view>
        <view class="masked-name">
          <text>{{maskedPrefix}}</text>
          <input class="name-blank" type="text" value="{{nameBlank}}" maxlength="{{missingCount}}" bindinput="onNameBlankInput" cursor-spacing="48" />
          <text>{{maskedSuffix}}</text>
        </view>
      </view>
      <button class="login-btn primary" loading="{{verifying}}" bindtap="verifyName">进入</button>
    </block>

    <block wx:elif="{{!profileReady}}">
      <view class="panel-card">
        <view class="panel-title">贵宾信息</view>
        <view class="form-item">
          <view class="label">姓名</view>
          <input value="{{name}}" placeholder="请输入姓名" placeholder-class="ph" bindinput="onNameInput" maxlength="32" cursor-spacing="48" />
        </view>
        <view class="form-item">
          <view class="label">性别</view>
          <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
            <view class="picker-value {{gender ? '' : 'empty'}}">{{gender || '请选择性别'}}</view>
          </picker>
        </view>
      </view>
      <button class="login-btn primary" bindtap="completeLogin">完成登录</button>
    </block>

    <block wx:else>
      <view class="panel-card record-card">
        <view class="panel-head">
          <view class="panel-title">参会登记记录</view>
          <view class="record-status {{recordStatus}}">{{recordStatusText}}</view>
        </view>
        <block wx:if="{{applyRecord}}">
          <view class="info-row">
            <text>参会场次</text>
            <text>{{applyRecord.eventCity || '待确认'}}场</text>
          </view>
          <view class="info-row">
            <text>同行人数</text>
            <text>{{applyRecord.attendees.length || 1}} 人</text>
          </view>
          <view wx:for="{{applyRecord.attendees}}" wx:key="id" wx:for-item="guest" class="attendee-detail">
            <view class="attendee-title">{{guest.guestIndex === 1 ? '主要联系人' : '同行人 ' + guest.guestIndex}}</view>
            <view class="detail-row"><text>姓名</text><text>{{guest.name}}</text></view>
            <view class="detail-row"><text>公司</text><text>{{guest.company || '未填写'}}</text></view>
            <view class="detail-row"><text>性别</text><text>{{guest.gender}}</text></view>
            <view class="detail-row"><text>手机号</text><text>{{guest.phone}}</text></view>
            <view class="detail-row"><text>职位</text><text>{{guest.position || '未填写'}}</text></view>
            <view class="detail-row"><text>住宿要求</text><text>{{guest.accommodation}}</text></view>
            <view class="detail-row"><text>房型</text><text>{{guest.roomType}}</text></view>
            <view class="detail-row"><text>入住时间</text><text>{{guest.checkinDateText}}</text></view>
          </view>
        </block>
        <view wx:elif="{{queryFailed}}" class="empty-record">登记记录查询失败，请稍后重试</view>
        <view wx:else class="empty-record">暂无参会登记记录</view>
      </view>

    </block>
  </view>
  <view class="agreement-footer">
    <view>我们尊重并保护您的个人信息。</view>
    <view class="agreement-links">
      <text class="agreement-link" bindtap="openAgreement">《用户服务协议》</text>
      <text>及</text>
      <text class="agreement-link" bindtap="openPrivacy">《隐私政策》</text>
    </view>
    <view class="delete-info-link" bindtap="requestPersonalInfoDeletion">注销并删除个人信息</view>
  </view>
</view>
</scroll-view>

<view class="bottom-nav">
  <view class="nav-item" bindtap="goHome">
    <view class="nav-icon home-icon"><view></view></view>
    <view class="nav-text">共创会</view>
  </view>
  <view class="nav-center" bindtap="goLottery">
    <view class="qr-circle lottery-circle">
      <view class="lottery-mark">LUCKY</view>
      <view class="lottery-mark-cn">抽奖码</view>
    </view>
  </view>
  <view class="nav-item active">
    <view class="nav-icon user-icon"><view></view></view>
    <view class="nav-text">个人中心</view>
  </view>
</view>
