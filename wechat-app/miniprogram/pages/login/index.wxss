page {
  background: #f5f7ff;
}

.login-page {
  min-height: 100vh;
  padding: 46rpx 44rpx calc(238rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #17233f;
}

.login-hero {
  text-align: center;
  padding-top: 24rpx;
}

.eyebrow {
  color: #8a7447;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.title {
  margin-top: 28rpx;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 500;
  letter-spacing: 6rpx;
}

.sub {
  margin: 26rpx auto 0;
  max-width: 560rpx;
  color: #6f7788;
  font-size: 25rpx;
  line-height: 1.7;
}

.member-card {
  position: relative;
  height: 520rpx;
  margin-top: 58rpx;
  padding: 62rpx 56rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #ffffff;
  background: #26397b;
  border-radius: 12rpx;
  box-shadow: 0 28rpx 68rpx rgba(38, 57, 123, 0.24);
}

.member-card.compact {
  height: 300rpx;
  margin-top: 40rpx;
  padding: 46rpx 44rpx;
}

.member-card.compact::before {
  left: -120rpx;
  bottom: -300rpx;
}

.member-card.compact::after {
  width: 250rpx;
  height: 250rpx;
}

.member-card.compact .card-shine {
  height: 130rpx;
}

.member-card.compact .card-title {
  font-size: 40rpx;
}

.member-card.compact .card-lines {
  width: 130rpx;
  right: 36rpx;
  bottom: 36rpx;
}

.member-card::before {
  content: '';
  position: absolute;
  left: -80rpx;
  bottom: -220rpx;
  width: 620rpx;
  height: 620rpx;
  border: 36rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.member-card::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border: 2rpx solid rgba(199, 168, 106, 0.42);
  transform: rotate(28deg);
}

.card-shine {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 210rpx;
  background: rgba(255, 255, 255, 0.08);
}

.card-label {
  position: relative;
  color: #c7a86a;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.card-title {
  position: relative;
  margin-top: 22rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
}

.card-sub {
  position: relative;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.card-lines {
  position: absolute;
  right: 48rpx;
  bottom: 48rpx;
  width: 180rpx;
}

.card-lines view {
  height: 2rpx;
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.46);
}

.login-panel {
  margin-top: 36rpx;
}

.panel-card {
  position: relative;
  margin-bottom: 28rpx;
  padding: 30rpx 32rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(199, 168, 106, 0.42);
  border-radius: 14rpx;
  box-shadow: 0 18rpx 42rpx rgba(38, 57, 123, 0.08);
  box-sizing: border-box;
}

.panel-card::before {
  content: '';
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 14rpx;
  height: 1rpx;
  background: rgba(38, 57, 123, 0.12);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  color: #17233f;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
}

.edit-link {
  color: #8a7447;
  font-size: 23rpx;
  line-height: 1;
  border-bottom: 1rpx solid #c7a86a;
  padding-bottom: 6rpx;
}

.login-btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-btn.primary {
  color: #ffffff;
  background: #26397b;
  box-shadow: 0 14rpx 34rpx rgba(38, 57, 123, 0.18);
}

.hint {
  margin-top: 28rpx;
  color: #949aa7;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.form-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(38, 57, 123, 0.12);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  color: #8a7447;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

input,
.picker-value {
  margin-top: 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  color: #17233f;
  font-size: 32rpx;
  font-weight: 500;
}

.ph,
.picker-value.empty {
  color: #b4bac7;
}

.form-item + .login-btn {
  margin-top: 42rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0 0;
  font-size: 27rpx;
  line-height: 1.45;
}

.info-row text:first-child {
  width: 180rpx;
  color: #8a7447;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.info-row text:last-child {
  flex: 1;
  color: #17233f;
  text-align: right;
  font-weight: 600;
  word-break: break-all;
}

.record-card {
  margin-top: 22rpx;
}

.record-status {
  padding: 8rpx 18rpx;
  color: #8a7447;
  border: 1rpx solid rgba(199, 168, 106, 0.78);
  border-radius: 26rpx;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 700;
}

.record-status.APPROVED {
  color: #26397b;
  border-color: rgba(38, 57, 123, 0.7);
}

.record-status.REJECTED {
  color: #a43a32;
  border-color: rgba(164, 58, 50, 0.56);
}

.empty-record {
  margin-top: 28rpx;
  padding: 28rpx 0;
  color: #949aa7;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
  border-top: 1rpx solid rgba(38, 57, 123, 0.1);
}

.bottom-nav { position:fixed;left:0;right:0;bottom:0;z-index:40;height:132rpx;padding:12rpx 48rpx calc(12rpx + env(safe-area-inset-bottom));box-sizing:content-box;display:flex;align-items:flex-start;justify-content:space-between;background:rgba(255,255,255,.96);border-top:1rpx solid #e7eaf1;box-shadow:0 -12rpx 34rpx rgba(31,44,84,.06); }
.nav-item { width:172rpx;height:116rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#a3a8b2; }
.nav-item.active { color:#26397b; }
.nav-text { margin-top:10rpx;font-size:23rpx;line-height:1;font-weight:600; }
.nav-icon { position:relative;width:52rpx;height:52rpx;box-sizing:border-box; }
.home-icon { border:4rpx solid currentColor;border-radius:24rpx 24rpx 6rpx 6rpx; }
.home-icon view { position:absolute;left:14rpx;right:14rpx;top:12rpx;bottom:-4rpx;border-left:4rpx solid currentColor;border-right:4rpx solid currentColor; }
.user-icon::before { content:'';position:absolute;left:13rpx;top:4rpx;width:26rpx;height:26rpx;border:4rpx solid currentColor;border-radius:50%;box-sizing:border-box; }
.user-icon::after { content:'';position:absolute;left:5rpx;bottom:2rpx;width:42rpx;height:25rpx;border:4rpx solid currentColor;border-top-left-radius:26rpx;border-top-right-radius:26rpx;border-bottom:none;box-sizing:border-box; }
.nav-center { width:172rpx;display:flex;justify-content:center;transform:translateY(-26rpx); }
.qr-circle { width:112rpx;height:112rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;border:8rpx solid #fff; }
.lottery-circle { flex-direction:column;background:linear-gradient(145deg,#101a35,#263b6b);border-color:#fffaf0;box-shadow:0 18rpx 38rpx rgba(14,25,52,.28),inset 0 0 0 1rpx rgba(218,184,112,.34); }
.lottery-mark { color:#d9bd7c;font-size:16rpx;line-height:1;letter-spacing:2rpx;font-family:Georgia,"Times New Roman",serif; }
.lottery-mark-cn { margin-top:8rpx;color:#fff;font-size:22rpx;line-height:1;font-weight:700;letter-spacing:2rpx; }

.profile-badge {
  position: absolute;
  right: 42rpx;
  top: 38rpx;
  padding: 9rpx 17rpx;
  color: #f0d38b;
  font-size: 19rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 3rpx;
  border: 1rpx solid rgba(240, 211, 139, .58);
  border-radius: 24rpx;
}

.attendee-detail {
  margin-top: 26rpx;
  padding: 24rpx;
  background: #f7f9fd;
  border: 1rpx solid rgba(38, 57, 123, .1);
  border-radius: 12rpx;
}

.attendee-title {
  padding-bottom: 15rpx;
  color: #20386f;
  font-size: 26rpx;
  font-weight: 800;
  border-bottom: 1rpx solid #e4e8f0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 15rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-row text:first-child { color: #8a7447; }
.detail-row text:last-child { flex: 1; color: #202b45; text-align: right; word-break: break-all; }

.agreement-footer {
  padding: 22rpx 28rpx 52rpx;
  color: #969ca8;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}

.agreement-link {
  color: #7f6736;
  text-decoration: underline;
}

.agreement-links { margin-top: 10rpx; }

.delete-info-link {
  margin-top: 18rpx;
  color: #7f6736;
  text-decoration: underline;
}

.verify-card {
  padding-bottom: 40rpx;
  text-align: center;
}

.verify-card .label {
  text-align: center;
}

.masked-name {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  color: #17233f;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.masked-name text {
  margin: 0 7rpx;
}

.name-blank {
  width: 96rpx;
  height: 92rpx;
  margin: 0 7rpx;
  padding: 0;
  color: #17233f;
  font-size: 48rpx;
  font-weight: 700;
  text-align: center;
  background: rgba(199, 168, 106, 0.1);
  border: 2rpx solid rgba(199, 168, 106, 0.7);
  border-radius: 14rpx;
  box-sizing: border-box;
}
