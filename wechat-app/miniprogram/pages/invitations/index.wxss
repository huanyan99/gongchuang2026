page { background:#f4f6fb; color:#102044; }
.page { min-height:100vh; padding-bottom:60rpx; }
.hero { padding:54rpx 30rpx 36rpx; background:linear-gradient(145deg,#081a40,#263f7f); color:#fff; }
.eyebrow { display:block; font-size:18rpx; letter-spacing:4rpx; color:#d4b56e; }
.title { display:block; margin-top:16rpx; font-size:48rpx; font-weight:700; }
.hero-sub { display:block; margin-top:18rpx; color:rgba(255,255,255,.68); font-size:23rpx; }
.stats { display:flex; margin-top:38rpx; }
.stats view { flex:1; text-align:center; border-right:1rpx solid rgba(255,255,255,.15); }
.stats view:last-child { border:0; }
.stats view { padding:12rpx 0; border-radius:10rpx; }
.stats view.active { background:rgba(255,255,255,.1); }
.list-stats { margin:16rpx 24rpx 24rpx; padding:14rpx; color:#fff; background:#142d63; border-radius:14rpx; box-sizing:border-box; }
.list-title { margin-top:50rpx; }
.stats text { display:block; }
.stats text:first-child { font-size:38rpx; font-weight:700; color:#f1d38c; }
.stats text:last-child { margin-top:8rpx; font-size:20rpx; color:rgba(255,255,255,.68); }
.card { margin:24rpx; padding:30rpx; background:#fff; border:1rpx solid rgba(190,158,91,.25); border-radius:16rpx; box-shadow:0 12rpx 30rpx rgba(16,32,68,.06); }
.card-title,.section-title { font-size:30rpx; font-weight:700; }
.section-title { margin:38rpx 28rpx 10rpx; }
.field { height:88rpx; line-height:88rpx; border-bottom:1rpx solid #e8eaf0; font-size:27rpx; }
.picker { display:flex; justify-content:space-between; color:#6c7484; }
.picker text { color:#243d78; }
.create-btn { margin-top:28rpx; background:#132b61; color:#fff; border-radius:8rpx; font-size:28rpx; }
.item-head { display:flex; justify-content:space-between; font-size:30rpx; font-weight:700; }
.item-head text:last-child,.status { color:#a67c35; font-size:24rpx; }
.company { display:block; margin-top:14rpx; color:#7b8190; font-size:24rpx; }
.actions { display:flex; gap:12rpx; margin-top:24rpx; }
.actions button { flex:1; margin:0; padding:0; font-size:23rpx; color:#263f7f; background:#f5f7fc; border-radius:6rpx; }
.actions button::after { border:0; }
.share-actions button { height:72rpx; line-height:72rpx; }
.list-button { display:flex; align-items:center; justify-content:center; margin-top:16rpx; width:100%; height:82rpx; color:#fff; background:linear-gradient(135deg,#132b61,#294785); border-radius:8rpx; font-size:26rpx; font-weight:700; letter-spacing:2rpx; box-shadow:0 10rpx 24rpx rgba(19,43,97,.16); }
.list-button text { margin-left:16rpx; font-size:38rpx; font-weight:400; }
.list-button::after { border:0; }
.review-actions .approve { color:#fff; background:#263f7f; }
.empty { margin:20rpx 24rpx; padding:50rpx; text-align:center; color:#989eaa; background:#fff; border-radius:14rpx; }
.guest-list { margin-top:22rpx; padding-top:10rpx; border-top:1rpx solid #edf0f5; }
.guest-row { padding:14rpx 0; border-bottom:1rpx dashed #e5e8ef; }
.guest-row text { display:block; margin-top:6rpx; color:#6f7788; font-size:23rpx; }
.guest-row text:first-child { color:#172a58; font-size:26rpx; font-weight:700; }
