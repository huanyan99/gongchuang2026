<view class="page">
  <view class="head">
    <view class="eyebrow">APPLICATION</view>
    <view class="title">参会登记</view>
    <view class="sub">请如实填写以下信息，提交后进入审核流程</view>
  </view>

  <view class="form">
    <view class="form-item">
      <view class="label">姓名 <text class="req">*</text></view>
      <input placeholder="姓名" placeholder-class="ph" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="label">手机号 <text class="req">*</text></view>
      <input type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="ph" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="label">公司 / 单位</view>
      <input placeholder="公司或单位名称" placeholder-class="ph" value="{{company}}" data-field="company" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="label">职位</view>
      <input placeholder="职位" placeholder-class="ph" value="{{position}}" data-field="position" bindinput="onInput" />
    </view>
    <view class="form-item last">
      <view class="label">申报说明</view>
      <textarea class="textarea" placeholder="简要介绍参会意向（选填，200 字以内）" placeholder-class="ph" value="{{reason}}" data-field="reason" bindinput="onInput" maxlength="200" />
    </view>
  </view>

  <view class="cta-wrap">
    <button class="cta" loading="{{submitting}}" bindtap="submit">提交申报</button>
    <view class="privacy-tip">提交即表示同意按照隐私指引收集和使用上述信息</view>
  </view>
</view>
