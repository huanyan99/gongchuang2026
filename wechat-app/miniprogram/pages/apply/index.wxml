<view class="page">
  <view class="head">
    <image class="head-bg" src="/images/banner.png" mode="aspectFill" />
    <view class="head-shade"></view>
    <view class="head-copy">
      <view class="eyebrow">BOCHU INVITATION</view>
      <view class="title">贵宾参会登记</view>
      <view class="gold-line"></view>
      <view class="sub">确认邀请函，并完善您的参会信息</view>
    </view>
  </view>

  <view wx:if="{{submitted}}" class="result-card">
    <view class="result-eyebrow">ACCESS CONFIRMED</view>
    <view class="result-title">邀请函已提交</view>
    <view class="result-sub">请妥善保存入场二维码，会务团队将据此为您完成签到核验。</view>
    <view class="qr-card">
      <view class="qr-code">
        <view class="qr-block large tl"></view>
        <view class="qr-block large tr"></view>
        <view class="qr-block large bl"></view>
        <view class="qr-dot d1"></view>
        <view class="qr-dot d2"></view>
        <view class="qr-dot d3"></view>
        <view class="qr-dot d4"></view>
        <view class="qr-dot d5"></view>
        <view class="qr-dot d6"></view>
        <view class="qr-dot d7"></view>
      </view>
      <view class="ticket-no">{{ticketNo}}</view>
    </view>
    <button class="cta secondary" bindtap="backHome">返回共创会</button>
  </view>

  <view wx:else class="form-card">
    <view class="card-head">
      <view>
        <view class="card-kicker">VIP LETTER</view>
        <view class="card-title">递交贵宾邀请函</view>
      </view>
      <view class="invite-seal">B</view>
    </view>

    <view class="form">
      <view class="form-item">
        <view class="label">姓名 <text class="req">*</text></view>
        <input placeholder="请填写姓名" placeholder-class="ph" value="{{name}}" data-field="name" bindinput="onInput" />
      </view>
      <view class="form-item">
        <view class="label">手机号 <text class="req">*</text></view>
        <input type="number" maxlength="11" placeholder="用于签到核验" placeholder-class="ph" value="{{phone}}" data-field="phone" bindinput="onInput" />
      </view>
      <view class="form-item">
        <view class="label">公司 / 单位</view>
        <input placeholder="公司或单位名称" placeholder-class="ph" value="{{company}}" data-field="company" bindinput="onInput" />
      </view>
      <view class="form-item">
        <view class="label">职位</view>
        <input placeholder="职位" placeholder-class="ph" value="{{position}}" data-field="position" bindinput="onInput" />
      </view>
      <view class="form-item last">
        <view class="label">参会备注</view>
        <textarea class="textarea" placeholder="如有接待偏好可简要填写（选填）" placeholder-class="ph" value="{{reason}}" data-field="reason" bindinput="onInput" maxlength="200" />
      </view>
    </view>

    <view class="cta-wrap">
      <button class="cta" loading="{{submitting}}" bindtap="submit">确认提交邀请函</button>
      <view class="privacy-tip">提交后，会务团队将依据上述信息为您安排入场核验与接待服务</view>
    </view>
  </view>
</view>
