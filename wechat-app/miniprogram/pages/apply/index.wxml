<page-meta page-style="overflow: hidden;" />
<scroll-view
  class="page-scroll"
  scroll-y
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
  bounces="{{true}}"
  scroll-with-animation="{{true}}"
>
<view class="page {{submitted ? 'done' : ''}}">
  <view class="head">
    <image class="head-bg" src="/images/banner.jpg" mode="aspectFill" />
    <view class="head-shade"></view>
    <view class="head-copy">
      <view class="eyebrow">{{submitted ? 'REGISTRATION' : 'INVITATION'}}</view>
      <view class="title">{{submitted ? '登记状态' : (editMode ? '修改登记' : '贵宾登记')}}</view>
      <view class="gold-line"></view>
      <view wx:if="{{!submitted}}" class="sub">{{editMode ? '修改提交后将重新进入审核' : '确认邀请函，并完善您的参会信息'}}</view>
    </view>
  </view>

  <view wx:if="{{submitted}}" class="result-card">
    <view class="result-eyebrow">REGISTRATION STATUS</view>
    <view class="result-title">{{applyStatus === 'APPROVED' ? '审核已通过' : (applyStatus === 'REJECTED' ? '审核未通过' : '已提交，等待审核')}}</view>
    <view class="result-sub" wx:if="{{applyStatus === 'PENDING'}}">会务团队正在审核您的参会登记，通过后可以前往领取抽奖码。</view>
    <view class="result-sub" wx:elif="{{applyStatus === 'REJECTED'}}">本次登记未通过审核，您可以修改登记信息后重新提交审核。</view>
    <view class="result-sub" wx:else>您的参会登记已审核通过，可以前往领取抽奖码。</view>

    <view class="guest-badge">贵宾 · {{name}}</view>
    <view wx:if="{{applyStatus === 'APPROVED' || applyStatus === 'REJECTED'}}" class="approved-actions">
      <button wx:if="{{applyStatus === 'APPROVED'}}" class="cta lottery-action" bindtap="goLottery">领取抽奖码</button>
      <button class="cta edit-action" bindtap="startEdit" disabled="{{editRemaining <= 0}}">修改参会登记信息</button>
      <view class="edit-chance">每人共有 2 次修改机会 · 当前剩余 {{editRemaining}} 次</view>
    </view>
    <button class="cta secondary" bindtap="backHome">返回共创会</button>
  </view>

  <view wx:else class="form-card">
    <view class="card-head">
      <view>
        <view class="card-kicker">VIP LETTER</view>
      </view>
      <view class="invite-ribbon">
        <view class="ribbon-wing left"></view>
        <view class="ribbon-knot"></view>
        <view class="ribbon-wing right"></view>
        <view class="ribbon-tail left"></view>
        <view class="ribbon-tail right"></view>
      </view>
    </view>

    <view class="form">
      <view class="form-item attendee-count">
        <view class="label">同行人数 <text class="req">*</text></view>
        <picker range="{{countOptions}}" value="{{attendeeCount - 1}}" bindchange="onAttendeeCountChange">
          <view class="picker-value">{{attendeeCount}} 人 ›</view>
        </picker>
      </view>
      <view wx:for="{{attendees}}" wx:key="index" wx:for-item="guest" class="guest-card">
        <view class="guest-title" wx:if="{{index === 0}}">主要联系人</view>
        <view class="guest-title" wx:else>同行人 {{index + 1}}</view>
        <view class="form-item"><view class="label">姓名 <text class="req">*</text></view><input value="{{guest.name}}" data-index="{{index}}" data-field="name" bindinput="onGuestInput" placeholder="请填写姓名" /></view>
        <view class="form-item">
          <view class="label">公司</view>
          <checkbox-group wx:if="{{index > 0}}" data-index="{{index}}" bindchange="onSameCompany"><label class="same-company"><checkbox value="same" checked="{{guest.sameCompany}}" color="#26397b" />与主要联系人一致</label></checkbox-group>
          <input value="{{guest.company}}" disabled="{{guest.sameCompany}}" data-index="{{index}}" data-field="company" bindinput="onGuestInput" placeholder="公司或单位名称" />
        </view>
        <view class="form-row">
          <view class="form-item half"><view class="label">性别 <text class="req">*</text></view><picker range="{{genderOptions}}" data-index="{{index}}" bindchange="onGenderChange"><view class="picker-value">{{guest.gender}} ›</view></picker></view>
          <view class="form-item half"><view class="label">职位</view><input value="{{guest.position}}" data-index="{{index}}" data-field="position" bindinput="onGuestInput" placeholder="请填写职位" /></view>
        </view>
        <view class="form-item"><view class="label">手机号 <text class="req">*</text></view><input type="number" maxlength="11" value="{{guest.phone}}" data-index="{{index}}" data-field="phone" bindinput="onGuestInput" placeholder="用于签到核验" /></view>
        <view class="form-item"><view class="label">住宿要求 <text class="req">*</text></view><picker range="{{accommodationOptions}}" data-index="{{index}}" bindchange="onAccommodationChange"><view class="picker-value">{{guest.accommodation}} ›</view></picker></view>
        <view wx:if="{{guest.accommodation === '需要住宿'}}" class="stay-info">
          <view class="form-item"><view class="label">房型</view><view class="fixed-value">柏楚预定房型</view></view>
          <view class="form-item"><view class="label">入住时间</view><view class="fixed-value">{{eventStayLabel}}</view></view>
        </view>
      </view>
      <view class="form-item last">
        <view class="label">参会备注</view>
        <textarea class="textarea" placeholder="如有接待偏好可简要填写（选填）" placeholder-class="ph" value="{{reason}}" data-field="reason" bindinput="onInput" maxlength="200" cursor-spacing="80" auto-height="{{true}}" />
      </view>
    </view>
  </view>
</view>
</scroll-view>

<view wx:if="{{!submitted}}" class="cta-wrap fixed">
  <button class="cta" loading="{{submitting}}" bindtap="submit">{{editMode ? '提交修改并重新审核' : '确认提交邀请函'}}</button>
  <view class="privacy-tip">提交后将用于入场核验与接待服务</view>
</view>
