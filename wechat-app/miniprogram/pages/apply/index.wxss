page {
  background: #f4f6fb;
}

.page {
  min-height: 100vh;
  color: #111827;
  padding-bottom: 190rpx;
}

.head {
  position: relative;
  height: 338rpx;
  overflow: hidden;
  border-bottom-left-radius: 46rpx;
  border-bottom-right-radius: 46rpx;
  background: #0b1b47;
}

.head-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.head-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(6, 16, 45, 0.1), rgba(6, 16, 45, 0.78));
}

.head-copy {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 42rpx;
  color: #ffffff;
}

.eyebrow,
.card-kicker,
.result-eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 14rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: 0;
}

.gold-line {
  margin-top: 18rpx;
  width: 82rpx;
  height: 3rpx;
  background: #d6b56d;
}

.sub {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0;
}

.form-card,
.result-card {
  position: relative;
  margin: -28rpx 28rpx 0;
  padding: 26rpx 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(214, 181, 109, 0.22);
  border-radius: 34rpx;
  box-shadow: 0 26rpx 56rpx rgba(13, 31, 76, 0.12);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #edf0f6;
}

.card-kicker,
.result-eyebrow {
  color: #8a7447;
}

.card-title,
.result-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  line-height: 1.15;
  color: #132653;
  font-weight: 800;
}

.invite-ribbon {
  position: relative;
  width: 92rpx;
  height: 68rpx;
}

.ribbon-wing,
.ribbon-knot,
.ribbon-tail {
  position: absolute;
  background: linear-gradient(145deg, #f4d98d, #c8a25d);
  box-shadow: 0 8rpx 18rpx rgba(160, 125, 52, 0.24);
}

.ribbon-wing {
  top: 8rpx;
  width: 42rpx;
  height: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.ribbon-wing.left {
  left: 4rpx;
  border-radius: 26rpx 8rpx 26rpx 10rpx;
  transform: rotate(-18deg);
}

.ribbon-wing.right {
  right: 4rpx;
  border-radius: 8rpx 26rpx 10rpx 26rpx;
  transform: rotate(18deg);
}

.ribbon-knot {
  left: 36rpx;
  top: 18rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #132653;
  box-shadow: 0 5rpx 12rpx rgba(19, 38, 83, 0.2);
}

.ribbon-tail {
  top: 40rpx;
  width: 22rpx;
  height: 28rpx;
  border-radius: 4rpx 4rpx 10rpx 10rpx;
}

.ribbon-tail.left {
  left: 34rpx;
  transform: rotate(9deg);
}

.ribbon-tail.right {
  right: 30rpx;
  transform: rotate(-9deg);
}

.form {
  padding: 0;
}

.form-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f6;
  display: flex;
  flex-direction: column;
}

.form-item.last {
  border-bottom: none;
}

.label {
  font-size: 22rpx;
  color: #8c94a3;
  letter-spacing: 2rpx;
  font-weight: 700;
}

.req {
  color: #b42318;
}

.ph {
  color: #b8bec9;
}

input {
  margin-top: 10rpx;
  height: 46rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.textarea {
  margin-top: 10rpx;
  width: 100%;
  min-height: 86rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 500;
}

.cta-wrap {
  padding-top: 10rpx;
}

.cta-wrap.fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 22rpx 32rpx 42rpx;
  background: linear-gradient(180deg, rgba(244, 246, 251, 0), rgba(244, 246, 251, 0.96) 28%, #f4f6fb);
}

.cta {
  height: 92rpx;
  line-height: 92rpx;
  background: #26397b;
  color: #fff;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0;
  box-shadow: 0 14rpx 26rpx rgba(38, 57, 123, 0.18);
}

.cta.secondary {
  margin-top: 34rpx;
  background: #ffffff;
  color: #26397b;
  border: 2rpx solid #26397b;
  box-shadow: none;
}

.privacy-tip {
  margin-top: 22rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #9aa0a8;
  text-align: center;
  letter-spacing: 0;
}

.result-card {
  text-align: center;
  padding-top: 46rpx;
}

.result-sub {
  margin: 18rpx auto 0;
  max-width: 540rpx;
  color: #6f7788;
  font-size: 24rpx;
  line-height: 1.7;
}

.qr-card {
  margin: 34rpx auto 0;
  width: 390rpx;
  padding: 30rpx 0 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #fbfcff, #f1f5ff);
  border: 1rpx solid rgba(38, 57, 123, 0.12);
}

.qr-code {
  display: flex;
  flex-wrap: wrap;
  margin: 0 auto;
  width: 252rpx;
  height: 252rpx;
  padding: 21rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background:
    linear-gradient(90deg, rgba(19, 38, 83, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(rgba(19, 38, 83, 0.08) 1rpx, transparent 1rpx),
    #ffffff;
  background-size: 30rpx 30rpx;
  box-shadow: inset 0 0 0 10rpx #ffffff;
}

.qr-cell {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
}

.qr-cell.dark {
  background: #132653;
}

.ticket-no {
  margin-top: 20rpx;
  color: #8a7447;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.qr-countdown {
  margin-top: 12rpx;
  color: #8c94a3;
  font-size: 20rpx;
  letter-spacing: 0;
}
