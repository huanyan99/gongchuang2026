page {
  background: #ffffff;
  color: #222222;
}

.policy-scroll {
  height: 100vh;
}

.page {
  min-height: 100vh;
  padding: 40rpx 34rpx calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.title {
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 700;
}

.updated {
  margin-top: 12rpx;
  color: #888888;
  font-size: 22rpx;
}

.intro {
  margin-top: 32rpx;
  color: #444444;
  font-size: 26rpx;
  line-height: 1.9;
  text-align: justify;
}

.section {
  margin-top: 38rpx;
}

.heading {
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 700;
}

.text {
  margin-top: 12rpx;
  color: #444444;
  font-size: 26rpx;
  line-height: 1.9;
  text-align: justify;
}
