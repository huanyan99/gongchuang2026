page{background:#f4f6fb;color:#17284f}.page{min-height:100vh;padding-bottom:60rpx}.hero{padding:48rpx 32rpx;color:#fff;background:linear-gradient(145deg,#081a40,#294681)}.hero text{display:block}.hero text:first-child{color:#d8bb76;font-size:18rpx;letter-spacing:5rpx}.hero text:last-child{margin-top:18rpx;font-size:40rpx;font-weight:800}.venue,.section{margin:26rpx;padding:30rpx;background:#fff;border:1rpx solid rgba(190,158,91,.28);border-radius:14rpx}.venue text{display:block}.venue text:first-child{color:#a67e32;font-size:20rpx;letter-spacing:3rpx}.venue text:nth-child(2){margin-top:16rpx;font-size:32rpx;font-weight:800}.venue text:nth-child(3){margin-top:12rpx;color:#858b97;font-size:23rpx}.venue button{margin-top:24rpx;color:#fff;background:#203b78;font-size:24rpx}.title{font-size:30rpx;font-weight:800}.row{display:flex;padding:26rpx 0;border-bottom:1rpx solid #e5e8ef}.row>text{width:70rpx;color:#b18a3d;font-weight:800}.row view{flex:1}.row view text{display:block}.row view text:first-child{font-size:27rpx;font-weight:700}.row view text:last-child{margin-top:9rpx;color:#777f8d;font-size:23rpx;line-height:1.7}.notice{margin:34rpx 26rpx;color:#8a7447;font-size:22rpx;text-align:center}
