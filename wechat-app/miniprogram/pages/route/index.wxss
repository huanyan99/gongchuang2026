page { background: #f4f6fb; color: #17284f; }

.page { min-height: 100vh; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }

.hero { padding: 48rpx 32rpx; color: #fff; background: linear-gradient(145deg, #081a40, #294681); }
.hero text { display: block; }
.hero text:first-child { color: #d8bb76; font-size: 18rpx; letter-spacing: 5rpx; }
.hero text:last-child { margin-top: 18rpx; font-size: 40rpx; font-weight: 800; }

.venue, .section {
  margin: 26rpx;
  padding: 30rpx;
  background: #fff;
  border: 1rpx solid rgba(190, 158, 91, 0.28);
  border-radius: 14rpx;
}

.venue text { display: block; }
.venue-label { color: #a67e32; font-size: 20rpx; letter-spacing: 3rpx; }
.venue-name { margin-top: 16rpx; font-size: 32rpx; font-weight: 800; }
.venue-address { margin-top: 12rpx; color: #858b97; font-size: 23rpx; line-height: 1.6; }

.venue-hall {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 20rpx;
  color: #8a6a20;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(214, 181, 109, 0.16);
  border: 1rpx solid rgba(168, 125, 49, 0.45);
  border-radius: 22rpx;
}

.venue button { margin-top: 24rpx; color: #fff; background: #203b78; font-size: 24rpx; }

.title { font-size: 30rpx; font-weight: 800; }

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e5e8ef;
}

.row:last-child { border-bottom: none; padding-bottom: 0; }

.row.column { flex-direction: column; gap: 10rpx; }

.row-name { flex: none; font-size: 26rpx; font-weight: 700; }

.row-detail {
  flex: 1;
  color: #777f8d;
  font-size: 23rpx;
  line-height: 1.7;
  text-align: right;
}

.row.column .row-detail { text-align: left; }

.notice { margin: 34rpx 26rpx; color: #8a7447; font-size: 22rpx; text-align: center; line-height: 1.6; }
