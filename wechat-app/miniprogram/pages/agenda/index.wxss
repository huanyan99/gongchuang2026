page{background:#f4f6fb;color:#152750}.page{min-height:100vh;padding-bottom:60rpx}.hero{padding:48rpx 32rpx;color:#fff;background:linear-gradient(145deg,#081a40,#294681)}.hero text{display:block}.hero text:first-child{color:#d8bb76;font-size:18rpx;letter-spacing:5rpx}.hero text:nth-child(2){margin-top:18rpx;font-size:42rpx;font-weight:800}.hero text:last-child{margin-top:14rpx;color:rgba(255,255,255,.66);font-size:23rpx}.agenda-card{margin:28rpx;padding:34rpx 24rpx 38rpx;color:#fff;background:linear-gradient(150deg,#284f9d,#3e66b7);border:1rpx solid rgba(255,255,255,.18);border-radius:18rpx;box-shadow:0 22rpx 54rpx rgba(27,59,125,.22)}.agenda-heading{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx 26rpx;border-bottom:1rpx solid rgba(255,255,255,.18)}.agenda-heading text:first-child{font-size:29rpx;font-weight:800;letter-spacing:2rpx}.agenda-heading text:last-child{color:#dfc986;font-size:21rpx;letter-spacing:3rpx}.agenda-group{display:flex;padding-top:26rpx}.time-column{width:194rpx;padding:82rpx 24rpx 0 0;text-align:center}.time-column text{display:block}.time-column text:first-child{font-size:27rpx;font-weight:800;letter-spacing:5rpx}.time-column text:last-child{margin-top:12rpx;font-size:22rpx;letter-spacing:3rpx}.agenda-line{position:relative;flex:1}.agenda-line::before{content:'';position:absolute;left:10rpx;top:14rpx;bottom:14rpx;border-left:3rpx dotted rgba(255,255,255,.76)}.agenda-item{position:relative;display:flex;align-items:flex-start;min-height:68rpx;padding-left:58rpx;font-size:25rpx;font-weight:700;line-height:1.45;letter-spacing:1rpx}.dot{position:absolute;z-index:1;left:0;top:7rpx;width:22rpx;height:22rpx;background:#fff;border:5rpx solid rgba(255,255,255,.22);border-radius:50%;background-clip:padding-box}.dinner-group{padding-top:0}.dinner-group .time-column{padding-top:4rpx}.dinner-group .time-column text:last-child{margin-top:0}.dinner-group .agenda-line::before{display:none}.agenda-item.dinner{min-height:auto}.notice{margin:32rpx 28rpx;padding:24rpx;color:#8a7447;background:#fff9eb;border-radius:10rpx;font-size:22rpx;text-align:center}.unavailable{margin:70rpx 28rpx;padding:72rpx 32rpx;text-align:center;background:#fff;border:1rpx solid rgba(199,168,106,.45);border-radius:18rpx;box-shadow:0 18rpx 46rpx rgba(38,57,123,.08)}.unavailable text{display:block}.unavailable text:nth-child(2){margin-top:28rpx;font-size:32rpx;font-weight:800}.unavailable text:last-child{margin-top:18rpx;color:#858c99;font-size:23rpx}.gem{width:16rpx;height:16rpx;margin:0 auto;background:#c7a86a;transform:rotate(45deg);box-shadow:0 0 22rpx rgba(199,168,106,.48)}
/* 手机端时间段横向展示，避免长标题被左侧时间栏挤压 */
.agenda-group{display:block;padding-top:28rpx}.time-column{width:auto;padding:0 0 24rpx;text-align:left;display:flex;align-items:center;gap:18rpx}.time-column text:first-child{padding:9rpx 18rpx;color:#1d3e83;background:#e7cf91;border-radius:22rpx;font-size:20rpx;letter-spacing:2rpx}.time-column text:last-child{margin-top:0;color:#fff;font-size:23rpx;font-weight:700;letter-spacing:2rpx}.agenda-line{padding-left:10rpx}.agenda-line::before{left:20rpx}.agenda-item{min-height:80rpx;padding-left:66rpx;font-size:25rpx;line-height:1.5}.agenda-item .dot{left:10rpx}.dinner-group{margin-top:10rpx;padding-top:25rpx;border-top:1rpx solid rgba(255,255,255,.18)}.dinner-group .time-column{padding:0 0 22rpx}.dinner-group .time-column text:first-child{display:none}.dinner-group .agenda-line{padding-left:10rpx}.agenda-item.dinner{min-height:54rpx;font-size:28rpx}
/* 深海蓝 + 香槟金 */
.agenda-card{background:linear-gradient(150deg,#0b2862 0%,#12458f 58%,#0b2d6c 100%);border-color:rgba(226,196,118,.42);box-shadow:0 24rpx 58rpx rgba(7,29,73,.3),inset 0 0 0 1rpx rgba(255,255,255,.06)}.agenda-heading{border-bottom-color:rgba(226,196,118,.35)}.agenda-heading text:first-child,.agenda-heading text:last-child{color:#e6c980}.time-column text:first-child{color:#0b2b68;background:linear-gradient(135deg,#f0d99d,#cfaa58)}.time-column text:last-child{color:#e6c980}.agenda-line::before{border-left-color:rgba(226,196,118,.72)}.agenda-item{color:#fff9eb}.agenda-item .dot{background:#e8cc86;border-color:rgba(255,244,211,.22);box-shadow:0 0 12rpx rgba(230,201,128,.38)}.dinner-group{border-top-color:rgba(226,196,118,.28)}
