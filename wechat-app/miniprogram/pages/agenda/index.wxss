page{background:#f4f6fb;color:#152750}.page{min-height:100vh;padding-bottom:60rpx}.hero{padding:48rpx 32rpx;color:#fff;background:linear-gradient(145deg,#081a40,#294681)}.hero text{display:block}.hero text:first-child{color:#d8bb76;font-size:18rpx;letter-spacing:5rpx}.hero text:nth-child(2){margin-top:18rpx;font-size:42rpx;font-weight:800}.hero text:last-child{margin-top:14rpx;color:rgba(255,255,255,.66);font-size:23rpx}.timeline{margin:28rpx}.item{display:flex;padding:30rpx 0;border-bottom:1rpx solid #dfe3eb}.item>text{width:116rpx;color:#a67e32;font-size:27rpx;font-weight:800}.item view{flex:1}.item view text{display:block}.item view text:first-child{font-size:29rpx;font-weight:700}.item view text:last-child{margin-top:10rpx;color:#7b8290;font-size:23rpx}.notice{margin:36rpx 28rpx;padding:24rpx;color:#8a7447;background:#fff9eb;border-radius:10rpx;font-size:22rpx;text-align:center}
