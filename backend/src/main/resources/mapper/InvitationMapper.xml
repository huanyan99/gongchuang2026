<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.app.mapper.InvitationMapper">

    <select id="selectByCode" resultType="com.example.app.entity.Invitation">
        SELECT id, code, max_uses AS maxUses, used_count AS usedCount, created_at AS createdAt
        FROM t_invitation
        WHERE code = #{code}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_invitation (code, max_uses)
        VALUES (#{code}, #{maxUses})
    </insert>

    <update id="increaseUsedCount">
        UPDATE t_invitation SET used_count = used_count + 1 WHERE id = #{id}
    </update>
</mapper>
